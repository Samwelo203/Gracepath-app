APP_NAME=Grace Path Centre Management System
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=https://gracepathcentermanagement-system.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@gracepath.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
DATABASE_URL=sqlite:///./gracepath.db

MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback

EQUITY_ENV=production
EQUITY_MERCHANT_CODE=
EQUITY_CONSUMER_SECRET=
EQUITY_API_KEY=
EQUITY_IPN_USER=
EQUITY_IPN_PASS=
EQUITY_PAYBILL=247247
EQUITY_ACCOUNT_NUMBER=
EQUITY_PUSH_CALLBACK_URL=https://your-domain.example/api/payments/equity/push-callback/replace-with-random-token
EQUITY_PUSH_CALLBACK_TOKEN=replace-with-a-random-token